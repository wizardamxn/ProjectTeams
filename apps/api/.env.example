# Copy to .env. Every variable is validated at boot by src/config.ts.

# --- Required ---
MONGO_URI=mongodb+srv://user:pass@cluster/projectteams
JWT_KEY=change-me-to-a-long-random-string

# --- Server ---
NODE_ENV=development
PORT=2222
LOG_LEVEL=info
# Number of reverse proxies in front of Node (Nginx = 1, Cloudflare + Nginx = 2)
TRUST_PROXY=1
# Set to true only once HTTPS terminates in front of the app
COOKIE_SECURE=false
# Public URL of the frontend, used in password-reset links
APP_URL=http://localhost:8080
# Comma-separated origins allowed in local dev (prod is same-origin)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# DNS servers for resolving Atlas SRV records; leave empty to use the system resolver
DNS_SERVERS=8.8.8.8,1.1.1.1

# --- Google sign-in (optional) ---
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# <APP_URL>/api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed when the API isn't served from APP_URL (e.g. local dev on two ports):
# GOOGLE_REDIRECT_URI=http://localhost:2222/api/auth/google/callback

# --- Email (password reset, invites) ---
# Without RESEND_API_KEY, dev logs the reset link; production refuses to send.
RESEND_API_KEY=
MAIL_FROM="Project Teams <no-reply@yourdomain.com>"

# --- AI ---
GOOGLE_GENERATIVE_AI_API_KEY=
AI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
AI_REQUESTS_PER_HOUR=60

# --- Storage (bucket must be PRIVATE; the API hands out short-lived signed URLs) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Queue ---
REDIS_URL=redis://localhost:6379
# Share sockets + presence through Redis so the API can run as several processes.
# Leave false for a single process (the default PM2 setup).
REALTIME_REDIS=false
