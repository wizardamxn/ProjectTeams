# --- Required ---
MONGO_URI=mongodb+srv://user:pass@cluster/projectteams
JWT_KEY=change-me-to-a-long-random-string

# --- Server ---
PORT=2222
# Number of reverse proxies in front of Node (Nginx = 1, Cloudflare + Nginx = 2)
TRUST_PROXY=1
# Set to true only once HTTPS terminates in front of the app
COOKIE_SECURE=false
# Public URL of the frontend, used in password-reset links
APP_URL=http://localhost:8080

# --- Email (password reset) ---
# Without RESEND_API_KEY, dev logs the reset link to the console; production refuses to send.
RESEND_API_KEY=
MAIL_FROM="Project Teams <no-reply@yourdomain.com>"

# --- AI ---
GOOGLE_GENERATIVE_AI_API_KEY=
AI_REQUESTS_PER_HOUR=60

# --- Storage (bucket must be PRIVATE; the API hands out short-lived signed URLs) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

# --- Queue ---
REDIS_URL=redis://localhost:6379
